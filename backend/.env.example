# Copie para backend/.env (ignorado pelo git) e preencha. Nunca commite a chave.
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
PULSO_LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
PULSO_LLM_ENABLED=true
PULSO_LLM_TEMPERATURE=0.2
PULSO_LLM_MAX_TOKENS=400
PULSO_LLM_TIMEOUT=25
# Tempo maximo total da analise com IA; depois disso o plano B responde
PULSO_LLM_BUDGET=40
# Grava a primeira resposta boa da IA por area e reaproveita (use na demo)
PULSO_LLM_DEMO_CACHE=.llm_demo_cache.json

# Provedor secundario (opcional)
GEMINI_API_KEY=

# Producao: autenticação obrigatoria + PostgreSQL. Demo e somente dados sinteticos.
VYTAI_MODE=production
DATABASE_URL=
SUPABASE_JWT_ISSUER=

# Execucao do RH: desativada ate configurar identidade, worker e destinos.
VYTAI_WORKER_ENABLED=false
VYTAI_WORKER_EMPRESA_ID=
VYTAI_WORKER_ACTOR_ID=
VYTAI_ACTIONS_EXTERNAL_ENABLED=false
VYTAI_CONNECTOR_EMPRESA_ID=
VYTAI_SLACK_BOT_TOKEN=
VYTAI_SLACK_ALLOWED_CHANNELS=
VYTAI_GOOGLE_CLIENT_ID=
VYTAI_GOOGLE_CLIENT_SECRET=
VYTAI_GOOGLE_REFRESH_TOKEN=
VYTAI_GOOGLE_ALLOWED_CALENDARS=
VYTAI_GOOGLE_ALLOWED_ATTENDEES=

GROQ_API_KEY=

# Tako Customer API: credenciais enviadas pela Tako (link seguro); token JWT dura 15 min.
TAKO_API_BASE_URL=https://customer-api.8arm.io
TAKO_ORGANIZATION_ID=
TAKO_ACCESS_KEY=
TAKO_ACCESS_SECRET=
