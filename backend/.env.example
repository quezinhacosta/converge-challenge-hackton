# Copie para backend/.env (ignorado pelo git) e preencha. Nunca commite a chave.
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
PULSO_LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
PULSO_LLM_ENABLED=true
PULSO_LLM_TEMPERATURE=0.2
PULSO_LLM_MAX_TOKENS=400
PULSO_LLM_TIMEOUT=25
# Tempo maximo total da analise com IA; depois disso o plano B responde
PULSO_LLM_BUDGET=40
# Grava a primeira resposta boa da IA por area e reaproveita (use na demo)
PULSO_LLM_DEMO_CACHE=.llm_demo_cache.json

# Provedor secundario (opcional)
GEMINI_API_KEY=

# Producao: autenticação obrigatoria + PostgreSQL. Demo e somente dados sinteticos.
VYTAI_MODE=production
DATABASE_URL=
SUPABASE_JWT_ISSUER=
